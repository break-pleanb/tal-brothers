# tal-brothers-server 환경 변수 템플릿 (M3 계획 7.2)
# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 서버 포트
PORT=3000

# Supabase 프로젝트 URL (예: https://abcdefghijklm.supabase.co)
SUPABASE_URL=

# service role 키. 절대 web(.env.local)에 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# 허용할 web 오리진. 폰이 PC 내부 IP로 접속하므로 둘 이상을 쉼표로 적는다
CORS_ORIGIN=http://localhost:5173,http://192.168.0.2:5173

# --- 운영 설정값 (비우면 기본값, M3 계획 10절 6번) ---
# 방 코드 길이 (기본 6)
ROOM_CODE_LENGTH=6
# hello 프레임 대기 시간 (기본 10초)
HELLO_TIMEOUT_SECONDS=10
# 마지막 활동 후 방 보관 시간 (기본 6시간)
ROOM_TTL_HOURS=6
