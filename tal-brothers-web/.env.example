# tal-brothers-web 환경 변수 템플릿 (M3 계획 7.2)
# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 커밋하지 않는다.

# Supabase 프로젝트 URL과 anon 키 (service role 키를 넣지 않는다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 주소. 폰에서도 접속하므로 localhost가 아니라 PC 내부 IP를 쓴다
VITE_API_BASE_URL=http://192.168.0.2:3000
VITE_WS_URL=ws://192.168.0.2:3000/ws
