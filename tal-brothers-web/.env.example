# tal-brothers-web 환경 변수 템플릿 (M3 계획 7.2)
# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 커밋하지 않는다.

# Supabase 프로젝트 URL과 anon 키 (service role 키를 넣지 않는다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 주소는 비워 두는 것이 기본이다.
# 비우면 지금 이 페이지를 연 호스트의 :3000을 쓴다 — PC는 localhost, 폰은 내부 IP로 각각 맞는다.
# 서버가 다른 기기에 있을 때만 주소를 직접 적는다
# VITE_API_BASE_URL=
# VITE_WS_URL=

# 서버 포트를 3000이 아닌 값으로 바꿨다면 여기에 적는다
# VITE_SERVER_PORT=3000

# 초대 QR에 실을 주소. **QR 전용이고 로그인 리디렉션에는 쓰지 않는다.**
# PC를 localhost로 열어 두면 폰이 그 주소로 올 수 없어 필요하다.
# PC도 내부 IP(http://192.168.0.2:5173)로 연다면 비워 둬도 된다
# VITE_PUBLIC_WEB_ORIGIN=http://192.168.0.2:5173
