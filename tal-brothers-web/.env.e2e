# 통합 테스트 전용 환경 변수 (m4-plan 11.3 M4-A). 비밀 값이 아니다.
# `vite --config vite.e2e.config.ts`(mode e2e)만 읽는다. Supabase에는 접속하지 않는다 — 인증은 가짜 모듈이다.

VITE_SUPABASE_URL=http://e2e.invalid
VITE_SUPABASE_ANON_KEY=e2e-anon-key

# 테스트 서버(e2e/e2eServer.ts)의 포트
VITE_SERVER_PORT=3100

# .env.local의 값이 섞이지 않도록 비워 둔다 (mode 파일이 .env.local보다 우선한다)
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_PUBLIC_WEB_ORIGIN=
